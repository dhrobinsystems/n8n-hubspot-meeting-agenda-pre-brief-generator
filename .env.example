# -----------------------------------------------------------------------------
# n8n-hubspot-meeting-agenda-pre-brief-generator
# Copy to .env (never commit it) and replace every REPLACE_WITH_ placeholder.
# Standalone engine: node --env-file=.env src/index.js --poll
# n8n: set the non-secret settings as n8n environment variables. Tokens live in
# n8n credentials; only the Slack incoming-webhook URLs are read from $env.
# -----------------------------------------------------------------------------

# --- Safety gates (fail-safe defaults) ---------------------------------------
# Only the literal string "false" turns a safety flag off.
# DRY_RUN=true: no LLM call (unless LLM_IN_DRY_RUN=true), no Slack/email dispatch.
DRY_RUN=true
# SANDBOX_MODE=true: HubSpot is read only after the portal is verified as SANDBOX or
# DEVELOPER_TEST, and every dispatch is redirected to the sandbox targets below.
SANDBOX_MODE=true
# Required for SANDBOX_MODE=false (production CRM data and real reps).
ALLOW_PRODUCTION_MODE=false

# --- HubSpot -------------------------------------------------------------------
HUBSPOT_SANDBOX_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_SANDBOX_PRIVATE_APP_TOKEN
HUBSPOT_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_SANDBOX_PORTAL_ID=REPLACE_WITH_HUBSPOT_SANDBOX_PORTAL_ID
HUBSPOT_BASE_URL=https://api.hubapi.com
TECH_STACK_PROPERTIES=tech_stack,tech_stack_notes
RECENT_DEAL_DAYS=90
MAX_COMPANIES=3
MAX_DEALS=5
MAX_NOTES_PER_DEAL=3
MAX_TICKETS=5
CURRENCY_CODE=USD

# --- Calendar ------------------------------------------------------------------
# google | outlook | webhook
CALENDAR_PROVIDER=google
LEAD_MINUTES=30
POLL_INTERVAL_MINUTES=5
# Comma-separated email domains that count as internal (your own company).
INTERNAL_DOMAINS=REPLACE_WITH_INTERNAL_EMAIL_DOMAINS
IGNORE_TITLE_KEYWORDS=[no brief],[internal]
SKIP_PRIVATE_EVENTS=true
GOOGLE_CALENDAR_ACCESS_TOKEN=REPLACE_WITH_GOOGLE_CALENDAR_ACCESS_TOKEN
GOOGLE_CALENDAR_ID=primary
MS_GRAPH_ACCESS_TOKEN=REPLACE_WITH_MS_GRAPH_ACCESS_TOKEN
CALENDAR_WEBHOOK_SECRET=REPLACE_WITH_CALENDAR_WEBHOOK_SECRET
REQUIRE_WEBHOOK_SIGNATURE=true

# --- LLM -----------------------------------------------------------------------
LLM_ENABLED=true
LLM_IN_DRY_RUN=false
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
# Any chat-completions model that supports JSON mode.
OPENAI_MODEL=REPLACE_WITH_OPENAI_MODEL
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
REDACT_PII_FOR_LLM=true

# --- Dispatch ------------------------------------------------------------------
# slack, email, or slack,email
DISPATCH_CHANNELS=slack
# webhook = incoming webhook to a channel; bot = DM the rep via users.lookupByEmail
SLACK_MODE=webhook
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL
SANDBOX_SLACK_WEBHOOK_URL=REPLACE_WITH_SANDBOX_SLACK_WEBHOOK_URL
SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN
SANDBOX_SLACK_CHANNEL_ID=REPLACE_WITH_SANDBOX_SLACK_CHANNEL_ID
EMAIL_FROM=REPLACE_WITH_EMAIL_FROM_ADDRESS
SANDBOX_EMAIL_RECIPIENT=REPLACE_WITH_SANDBOX_EMAIL_RECIPIENT
FALLBACK_RECIPIENT_EMAIL=REPLACE_WITH_FALLBACK_RECIPIENT_EMAIL
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
# true = implicit TLS (465); false = STARTTLS (587). Plaintext is refused.
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
BRIEF_TIMEZONE=UTC

# --- Standalone runtime --------------------------------------------------------
STATE_FILE=REPLACE_WITH_STATE_FILE_PATH
HOST=127.0.0.1
PORT=8788
